  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>Jours à poursuivre des ombres</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>Tous ceux qui restent sont des souvenirs vains</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>Comme si un feu m’avait balayé</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>Tout ce que j’ai en main est de la poussière de cendre</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>J’ai couru sans répit</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>Ces moments passés qui m’ont étouffé</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>Finiront-ils aussi par me manquer ?</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>Un jour très, très lointain d’aujourd’hui</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>Lorsque je repenserai à ces souvenirs,</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>J’espère être capable de sourire</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>Quel que soit le temps qu’il me reste</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>Je dois à présent avancer</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>Me brûler jusqu’à disparaître</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>Telle une bougie qui se consume d’elle-même</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>Sans un instant pour respirer</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>J’ai été jeté dans des jours mouvementés</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>J’espère pouvoir aller dans mon sens</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>Un jour très, très lointain d’aujourd’hui</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>Lorsque je repenserai à ces souvenirs</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>Je souhaite être capable de sourire</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>Laissez-moi, laissez-moi m’envoler, très très loin</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>Pour que je puisse atteindre les étoiles comme un oiseau sous le ciel nocturne</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>Cette nuit, cette nuit me visitera à nouveau, j’en suis sûr, mais…</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>Tout va bien, puisque je peux continuer de vivre</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>Tout va bien</color>"
    }
  ]
